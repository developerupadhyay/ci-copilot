# ==========================================================
# Secure Production Configuration (Node.js Electron Backend)
# ==========================================================

# Google Gemini API Key (All-in-One: Audio STT, Screen Vision OCR, Answer Generation)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Groq API Key for Whisper Large V3 Speech-to-Text
# Get your free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Default AI Model: gemini-2.0-flash or gemini-1.5-flash
DEFAULT_GEMINI_MODEL=gemini-2.0-flash
